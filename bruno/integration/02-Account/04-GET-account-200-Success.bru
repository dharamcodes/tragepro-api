meta {
  name: 04-GET-account-200-Success
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/account/{{testAccountId}}
  body: none
  auth: inherit
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.name).to.equal(bru.getVar("testUserName"));
  expect(res.body.email).to.equal(bru.getVar("testEmail"));
  expect(res.body.phoneNumber).to.equal(9876543210);
  expect(res.body.isActive).to.be.true;
  expect(res.body.identifier).to.equal(bru.getVar("testAccountId"));
}
