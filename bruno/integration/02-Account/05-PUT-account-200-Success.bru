meta {
  name: 05-PUT-account-200-Success
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/account/{{testAccountId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Updated {{testUserName}}",
    "email": "{{testEmail}}",
    "phoneNumber": 9876543211,
    "isActive": true
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.name).to.equal("Updated " + bru.getVar("testUserName"));
  expect(res.body.email).to.equal(bru.getVar("testEmail"));
  expect(res.body.phoneNumber).to.equal(9876543211);
  expect(res.body.isActive).to.be.true;
  expect(res.body.identifier).to.equal(bru.getVar("testAccountId"));
}
