meta {
  name: 04-GET-strategy-id-200-Success
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/strategy/{{testStrategyId}}
  body: none
  auth: inherit
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.equal(bru.getVar("testStrategyId"));
  expect(res.body.strategy.name).to.equal("INTRADAY_VP_VWAP");
}
