meta {
  name: 01-POST-orders-200-Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: inherit
}

body:json {
  {
    "symbol": "AAPL",
    "quantity": 10.0,
    "price": 150.0,
    "orderType": "LIMIT",
    "side": "BUY"
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.not.be.empty;
  expect(res.body.symbol).to.equal("AAPL");
  expect(res.body.orderType).to.equal("LIMIT");
  expect(res.body.status).to.equal("SUBMITTED");
  bru.setVar("testOrderId", res.body.id);
}
