meta {
  name: 05-PUT-watchlists-id-200-Success
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/watchlists/{{testWatchlistId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Updated Integration Tech Giants",
    "description": "Updated description",
    "stocks": [
      {
        "id": "AAPL",
        "name": "Apple Inc."
      },
      {
        "id": "GOOGL",
        "name": "Alphabet Inc."
      }
    ]
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.equal(bru.getVar("testWatchlistId"));
  expect(res.body.name).to.equal("Updated Integration Tech Giants");
  expect(res.body.description).to.equal("Updated description");
  expect(res.body.stocks).to.be.an('array').with.lengthOf(2);
}
