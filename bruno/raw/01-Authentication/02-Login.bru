meta {
  name: 02-Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "trader01",
    "password": "Password123!"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody().token) {
    bru.setEnvVar("authToken", res.getBody().token);
  }
}
