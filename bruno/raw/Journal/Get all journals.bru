meta {
  name: Get all journals
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/journal?accountId=your-account-id&page=0&size=10&sort=entryTime,desc
  body: none
  auth: inherit
}

params:query {
  accountId: your-account-id
  page: 0
  size: 10
  sort: entryTime,desc
  ~symbol: AAPL
  ~tradeType: LONG
  ~year: 2026
  ~month: 6
  ~day: 13
}
