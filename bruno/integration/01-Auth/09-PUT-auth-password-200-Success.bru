meta {
  name: 09-PUT-auth-password-200-Success
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/v1/auth/password
  body: json
  auth: inherit
}

body:json {
  {
    "userName": "{{testUserName}}",
    "password": "{{testPassword}}1",
    "confirmPassword": "{{testPassword}}1"
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(202);
  bru.setVar("testPassword", bru.getVar("testPassword") + "1");
}
