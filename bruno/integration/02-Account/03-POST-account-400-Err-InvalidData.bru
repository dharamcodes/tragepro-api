meta {
  name: 03-POST-account-400-Err-InvalidData
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/account
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Invalid User",
    "email": "invalid-email",
    "phoneNumber": 12345,
    "isActive": true
  }
}

script:post-response {
  expect(res.getStatus()).to.be.within(400, 599);
}
