meta {
  name: 04-GET-candles-id-200-Success
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/candles/{{testCandleId}}
  body: none
  auth: inherit
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.equal(bru.getVar("testCandleId"));
  expect(res.body.symbolData.symbol).to.equal("AAPL");
  expect(res.body.candleData.open).to.equal(130.0);
}
