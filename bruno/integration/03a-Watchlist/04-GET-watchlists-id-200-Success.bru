meta {
  name: 04-GET-watchlists-id-200-Success
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/watchlists/{{testWatchlistId}}
  body: none
  auth: inherit
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.equal(bru.getVar("testWatchlistId"));
  expect(res.body.name).to.equal("Integration Tech Giants");
  expect(res.body.description).to.equal("Tech watchlist for integration test");
  expect(res.body.stocks).to.be.an('array').with.lengthOf(2);
}
