meta {
  name: Get all OHLCV data
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/ohlcvdata
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
}

script:post-response {
  assertOk();
  assertPageStructure();
  if (res.status === 200 && res.body) {
    setOhlcvVarsFromPage(res.body);
  }
}
