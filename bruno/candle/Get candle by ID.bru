meta {
  name: Get candle by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/candle/:id
  body: none
  auth: inherit
}

params:path {
  id: {{candleId}}
}

script:post-response {
  assertOk();
  assertBodyHasKey('symbol');
  assertBodyHasKey('candle');
  if (res.status === 200 && res.body) {
    setCandleVars(res.body);
  }
}
