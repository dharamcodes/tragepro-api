meta {
  name: 01-POST-candles-200-Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/candles
  body: json
  auth: inherit
}

body:json {
  {
    "symbolData": {
        "id": "AAPL",
        "name": "Apple Inc."
    },
    "candleData": {
        "timestamp": 1609459200000,
        "open": 130.0,
        "high": 135.0,
        "low": 128.0,
        "close": 133.0,
        "volume": 100000
    }
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.not.be.empty;
  expect(res.body.symbolData.id).to.equal("AAPL");
  expect(res.body.candleData.open).to.equal(130.0);
  expect(res.body.candleData.close).to.equal(133.0);
  bru.setVar("testCandleId", res.body.id); 
}
