  body: json
  auth: none
}

body:json {
  {
    "email": "invalid-email",
    "userName": "testUser",
    "password": "123",
    "role": "SUPER_USER"
  }
}

script:post-response {
  expect(res.getStatus()).to.be.within(400, 499);
}
