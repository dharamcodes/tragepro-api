meta {
  name: Update account details
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/account/:identifier
  body: json
  auth: inherit
}

params:path {
  identifier: {{accountIdentifier}}
}

body:json {
  {
    "name": "Admin Account Updated",
    "email": "admin.updated@email.com",
    "identifier": "{{accountIdentifier}}",
    "phoneNumber": 9454318045,
    "isActive": true
  }
}

script:post-response {
  const body = res.body;
  if (res.status === 200 && body) {
    setAccountVars(body);
  }
}
