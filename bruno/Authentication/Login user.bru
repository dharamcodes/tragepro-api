meta {
  name: Login user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "admin01",
    "password": "admin01"
  }
}

script:post-response {
  const body = res.body;
  if (res.status === 200 && body) {
    setAuthToken(body);
    if (body.userName) bru.setVar(VARS.AUTH_USERNAME, body.userName);
  }
}
