meta {
  name: Get account details
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/account/:identifier
  body: none
  auth: inherit
}

params:path {
  identifier: {{accountIdentifier}}
}

script:post-response {
  const body = res.body;
  if (res.status === 200 && body) {
    setAccountVars(body);
  }
}
