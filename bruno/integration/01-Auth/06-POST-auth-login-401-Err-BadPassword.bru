meta {
  name: 06-POST-auth-login-401-Err-BadPassword
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{testUserName}}",
    "password": "wrongpassword123"
  }
}

script:post-response {
  expect(res.getStatus()).to.be.within(400, 499);
}
