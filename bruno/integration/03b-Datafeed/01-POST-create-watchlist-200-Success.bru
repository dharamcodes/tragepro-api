meta {
  name: 01-POST-create-watchlist-200-Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/watchlists
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Datafeed Load Test Watchlist",
    "description": "Watchlist for datafeed E2E load test",
    "stocks": [
      {
        "id": "AAPL",
        "symbol": "AAPL",
        "name": "Apple Inc."
      }
    ]
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.name).to.equal("Datafeed Load Test Watchlist");
  bru.setVar("testDatafeedWatchlistId", res.body.id);
}
