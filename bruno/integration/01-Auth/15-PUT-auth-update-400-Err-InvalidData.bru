meta {
  name: 15-PUT-auth-update-400-Err-InvalidData
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/api/v1/auth/update/{{testUserName}}
  body: json
  auth: inherit
}

body:json {
  {
    "email": "invalidemail",
    "userName": "",
    "password": "123",
    "role": null
  }
}

script:post-response {
  expect(res.getStatus()).to.be.within(400, 599);
}
