meta {
  name: 08-PUT-auth-update-200-Success
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/auth/update/{{testUserName}}
  body: json
  auth: inherit
}

body:json {
  {
    "email": "updated_{{testEmail}}",
    "userName": "{{testUserName}}",
    "password": "{{testPassword}}",
    "role": "SUPER_USER",
    "isActive": true
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.userName).to.equal(bru.getVar("testUserName"));
  expect(res.body.role).to.equal("SUPER_USER");
  expect(res.body.isActive).to.be.true;
}
