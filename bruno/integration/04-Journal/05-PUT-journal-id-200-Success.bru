meta {
  name: 05-PUT-journal-id-200-Success
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/journal/{{testJournalId}}
  body: json
  auth: inherit
}

body:json {
  {
    "accountId": "{{testAccountId}}",
    "symbol": "AAPL",
    "tradeType": "LONG",
    "status": "CLOSED",
    "entryPrice": 150.0,
    "exitPrice": 160.0,
    "quantity": 10.0,
    "pnl": 100.0,
    "entryTime": "2026-06-13T10:00:00Z",
    "exitTime": "2026-06-13T12:00:00Z"
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.equal(bru.getVar("testJournalId"));
  expect(res.body.status).to.equal("CLOSED");
  expect(res.body.pnl).to.equal(100.0);
}
