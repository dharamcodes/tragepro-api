meta {
  name: 05-PUT-candles-id-200-Success
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/candles/{{testCandleId}}
  body: json
  auth: inherit
}

body:json {
  {
    "symbolData": {
        "symbol": "AAPL",
        "name": "Apple Inc. Updated"
    },
    "candleData": {
        "timestamp": 1609459200000,
        "open": 131.0,
        "high": 135.0,
        "low": 128.0,
        "close": 133.0,
        "volume": 100000
    }
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.id).to.equal(bru.getVar("testCandleId"));
  expect(res.body.symbolData.symbol).to.equal("AAPL");
  expect(res.body.symbolData.name).to.equal("Apple Inc. Updated");
  expect(res.body.candleData.open).to.equal(131.0);
}
