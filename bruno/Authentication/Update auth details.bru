meta {
  name: Update auth details
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/auth/update/:userName
  body: json
  auth: inherit
}

params:path {
  userName: admin
}

body:json {
  {
    "email": "admin.mail@tragepro.com",
    "userName": "admin",
    "password": "admin",
    "role": "SUPER_USER",
    "isActive": true
  }
}
