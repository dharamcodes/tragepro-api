meta {
  name: Create account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/account
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Admin Account",
    "email": "admin.mail@email.com",
    "phoneNumber": 9454318045,
    "isActive": false
  }
}

script:post-response {
  const body = res.body;
  if (res.status === 200 && body) {
    setAccountVars(body);
  }
}
