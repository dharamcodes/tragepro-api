meta {
  name: 10-PUT-auth-password-400-Err-InvalidPassword
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/v1/auth/password
  body: json
  auth: inherit
}

body:json {
  {
    "userName": "{{testUserName}}",
    "password": "123",
    "confirmPassword": "123"
  }
}

script:post-response {
  expect(res.getStatus()).to.be.within(400, 499);
}
