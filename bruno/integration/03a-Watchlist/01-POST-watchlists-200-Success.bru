meta {
  name: 01-POST-watchlists-200-Success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/watchlists
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Integration Tech Giants",
    "description": "Tech watchlist for integration test",
    "stocks": [
      {
        "id": "AAPL",
        "name": "Apple Inc."
      },
      {
        "id": "MSFT",
        "name": "Microsoft Corp."
      }
    ]
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  bru.setVar("testWatchlistId", res.body.id);
}
