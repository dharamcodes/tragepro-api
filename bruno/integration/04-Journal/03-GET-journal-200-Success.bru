meta {
  name: 03-GET-journal-200-Success
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/journal?accountId={{testAccountId}}
  body: none
  auth: inherit
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
  expect(res.body.content).to.be.an('array');
  expect(res.body.content.length).to.be.greaterThan(0);
}
