meta {
  name: 05-PUT-account-200-Success
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/account/{{testAccountId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Updated {{testUserName}}",
    "email": "{{testEmail}}",
    "phoneNumber": 9876543211,
    "isActive": true
  }
}

script:post-response {
  expect(res.getStatus()).to.equal(200);
}
