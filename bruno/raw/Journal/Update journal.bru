meta {
  name: Update journal
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/journal/:id
  body: json
  auth: inherit
}

params:path {
  id: journal-id-here
}

body:json {
  {
    "accountId": "your-account-id",
    "symbol": "AAPL",
    "tradeType": "LONG",
    "status": "CLOSED",
    "entryPrice": 150.0,
    "exitPrice": 160.0,
    "quantity": 10.0,
    "pnl": 100.0,
    "entryTime": "2026-06-13T10:00:00Z",
    "exitTime": "2026-06-13T12:00:00Z",
    "notes": "Closed trade with profit"
  }
}
